# Root domain the app is served from (no protocol/port).
# Sub-labels of this domain become tenant slugs, e.g. acme.example.com -> "acme".
NEXT_PUBLIC_BASE_DOMAIN=example.com

# Verified custom (vanity) domains are configured per-tenant in lib/tenants.ts
# via the `customDomains` field. They are resolved before subdomain matching.
